APP_ENV=development
APP_PORT=8080

# PostgreSQL local — cài trực tiếp trên máy, không cần Docker
# macOS:  brew install postgresql@16 && brew services start postgresql@16
# Ubuntu: sudo apt install postgresql postgresql-contrib
DB_HOST=localhost
DB_PORT=5432
DB_USER=identity
DB_PASSWORD=identity
DB_NAME=identity_core
DB_SSLMODE=disable

INTERNAL_API_KEY=change-me-internal-key
ADMIN_API_KEY=change-me-admin-key

# Admin UI login (username/password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRY_HOURS=24
# End-user (Mini App) JWT — defaults to JWT_SECRET if empty
USER_JWT_SECRET=change-me-user-jwt-secret
USER_JWT_EXPIRY_HOURS=1
# When true, accept spoofable X-User-ID / Bearer <numeric id> (default: true in non-production)
# ALLOW_LEGACY_USER_ID_HEADER=false

# Comma-separated browser origins (default in development: localhost:3000, 5173)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# When true, POST /api/v1/user/auth/zalo accepts zalo_id (+ name/avatar/phone) without Zalo Graph
ZALO_AUTH_DEV_MODE=true

# Zalo App secret key (developers.zalo.me) — required to exchange getPhoneNumber token
ZALO_APP_SECRET_KEY=
